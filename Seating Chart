        .results { margin-top: 20px; text-align: left; max-height: 250px; overflow-y: auto; }
        .result-item { background: #e8eef5; padding: 14px 16px; border-radius: 10px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; }
        .guest-name { font-weight: 600; color: #333; }
        .table-badge { background: #1b365d; color: #fff; padding: 6px 12px; border-radius: 20px; font-weight: bold; font-size: 14px; }
        .no-match { color: #888; text-align: center; margin-top: 15px; font-size: 14px; display: none; }
